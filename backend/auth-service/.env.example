# TruthShield X Auth Service Configuration

ENVIRONMENT=development
PROJECT_NAME="TruthShield X Auth Service"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=truthshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security & JWT Configuration
# MUST be minimum 32 characters in production
JWT_SECRET_KEY=change_this_super_secret_jwt_key_truthshield_x_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Verification & Enforcement Policy
REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
